# Generated by edgeweir-node. DO NOT EDIT: the agent rewrites this file.
#
# Only structural settings live here (listeners, cache zones, resolver,
# trust store). Sites, domains, origins, cache rules and purge markers are
# hot-updated through the control socket into lua_shared_dict and never
# cause a reload.

{{- if .ModSecurityConf }}

# ModSecurity-nginx: loaded because a site runs the OWASP CRS.
load_module {{ .ModSecurityModule }};
{{- end }}

worker_processes {{ .WorkerProcesses }};
{{- if .WorkerRlimitNofile }}
worker_rlimit_nofile {{ .WorkerRlimitNofile }};
{{- end }}
{{- if .User }}
user {{ .User }};
{{- end }}
pid {{ .Prefix }}/logs/nginx.pid;
error_log stderr {{ .ErrorLogLevel }};
pcre_jit on;
{{- if .ShutdownTimeoutMS }}
# Workers a reload replaces close the connections they still serve after
# this long (--stream-shutdown-timeout).
worker_shutdown_timeout {{ .ShutdownTimeoutMS }}ms;
{{- end }}

events {
    worker_connections {{ .WorkerConnections }};
}

http {
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65s;
    client_max_body_size 100m;

    client_body_temp_path {{ .Prefix }}/tmp/client_body;
    proxy_temp_path {{ .Prefix }}/tmp/proxy;
    fastcgi_temp_path {{ .Prefix }}/tmp/fastcgi;
    uwsgi_temp_path {{ .Prefix }}/tmp/uwsgi;
    scgi_temp_path {{ .Prefix }}/tmp/scgi;

    lua_package_path "{{ .LuaDir }}/?.lua;;";
{{- /* Static dictionaries and one reserved counter partition per site. */}}
{{- range .SharedDicts }}
    lua_shared_dict {{ .Name }} {{ if .SizeKB }}{{ .SizeKB }}k{{ else }}{{ .SizeMB }}m{{ end }};
{{- end }}
    # Error-level log lines, per worker, to tell TLS failures of origin
    # attempts apart from connection failures (edgeweir.upstreamerr).
    lua_capture_error_log 64k;
    init_by_lua_block {
        require("edgeweir.init").init({
            resolvers = { {{- range $i, $r := .Resolvers }}{{ if $i }}, {{ end }}"{{ $r }}"{{ end -}} },
            ipv6 = {{ .ResolverIPv6 }},
            -- Identifies this file; GET /v1/status reports it, so the agent
            -- can tell that a reload really loaded it.
            conf_id = "{{ .ConfID }}",
            geoip_socket = "{{ .GeoIPSocket }}",
            -- Bans held in edgeweir_bans (edgeweir.bans).
            ban_capacity = {{ .BanCapacity }},
{{- if .L4Servers }}
            -- The stream subsystem's control relay (edgeweir.l4control):
            -- the control API forwards /v1/l4 requests to it.
            l4_socket = "unix:{{ .L4Socket }}",
{{- end }}
{{- if .ModSecurityConf }}
            -- Request body limits of the edge layer's CRS locations
            -- (@edgeweir_waf_<limit>, edgeweir.waf).
            waf_body_limits = { {{- range $i, $l := .WAFBodyLimits }}{{ if $i }}, {{ end }}{{ $l }}{{ end -}} },
{{- end }}
        })
    }
    init_worker_by_lua_block { require("edgeweir.init").init_worker() }
{{- if .ModSecurityConf }}

    # OWASP CRS, parsed once and shared by the CRS locations; ModSecurity
    # stays off everywhere else.
    modsecurity_rules_file {{ .ModSecurityConf }};
{{- end }}

    # Nameservers from {{ .ResolvConf }} (origins are resolved in Lua).
    resolver {{ join .Resolvers " " }} valid=30s{{ if not .ResolverIPv6 }} ipv6=off{{ end }};
    resolver_timeout 5s;
{{ range .CacheZones }}
    proxy_cache_path {{ $.CacheDir }}/{{ .Name }} levels=1:2 keys_zone={{ .Name }}:{{ .KeysZoneMB }}m max_size={{ .MaxSizeMB }}m inactive={{ .InactiveSeconds }}s use_temp_path=off;
{{- end }}

    # Range handling at the edge, chosen by edgeweir.router per request:
    # "slice" fetches and caches 1 MiB slices, "pass" forwards the client's
    # Range (uncached requests), anything else lets the cache fetch whole
    # objects. volatile: slice subrequests must re-evaluate $slice_range.
    map $edgeweir_range_mode $edgeweir_range {
        volatile;
        default "";
        slice   $slice_range;
        pass    $http_range;
    }
    map $edgeweir_range_mode $edgeweir_if_range {
        volatile;
        default "";
        pass    $http_if_range;
    }
    map $edgeweir_range_mode $edgeweir_slice_key {
        volatile;
        default "";
        slice   "|$slice_range";
    }
    # Accept-Encoding towards the origin: the client's, or none for sites
    # the edge compresses (edgeweir.router sets $edgeweir_strip_ae), so the
    # cache holds one uncompressed object that serves every encoding.
    map $edgeweir_strip_ae $edgeweir_upstream_ae {
        default $http_accept_encoding;
        1       "";
    }
    map $http_upgrade $edgeweir_origin_connection {
        default upgrade;
        ""      "";
    }
    # Request id of the edge layer (X-Request-Id, error pages, access logs):
    # the client's when it is valid, nginx's own otherwise.
    map $http_x_request_id $edgeweir_request_id {
        default $request_id;
        "~^[A-Za-z0-9._:-]{8,128}$" $http_x_request_id;
    }

    # Edge -> origin layer (local unix sockets). The variant without TLS
    # verification serves sites that turned it off.
    upstream edgeweir_origin_verify {
        server unix:{{ .OriginSocket }};
        keepalive 64;
    }
    upstream edgeweir_origin_noverify {
        server unix:{{ .OriginSocketNoVerify }};
        keepalive 64;
    }

    # Origin layer -> origins: peers, retries, timeouts and keep-alive pools
    # (keyed by address, port and SNI) are chosen per request in Lua.
    # nginx >= 1.29.7 caches upstream connections by default
    # (`keepalive 32 local`) and matches them on the peer address only: a
    # TLS connection verified for one name would be reused for a request
    # that must verify another, and sites that disable keep-alive would be
    # pooled anyway. The zero value disables that cache; pooling stays with
    # balancer.enable_keepalive, keyed by address, port and SNI.
    upstream edgeweir_balancer {
        server 0.0.0.1;
        keepalive 0;
        balancer_by_lua_block { require("edgeweir.origin").balance() }
    }

    # Control API for the agent (JSON). Unix socket only, never TCP.
    server {
        listen unix:{{ .ControlSocket }};
        client_max_body_size 256m;
        client_body_buffer_size 16m;

        location / {
            content_by_lua_block { require("edgeweir.control").handle() }
        }
    }
{{ range .OriginLayers }}
    # Origin layer{{ if not .Verify }} without TLS verification{{ end }}: reachable only through its
    # unix socket from the edge layer below; internal X-Edgeweir-* request
    # headers never reach the origin.
    server {
        listen unix:{{ .Socket }};

        location / {
            set $edgeweir_upstream_scheme "http";
            set $edgeweir_upstream_host "";
            set $edgeweir_upstream_uri "";
            set $edgeweir_authorization "";
            set $edgeweir_amz_date "";
            set $edgeweir_amz_content_sha256 "";
            set $edgeweir_trust_store "{{ if $.TrustedCA }}ok{{ else }}missing{{ end }}";
            set $edgeweir_ssl_name "";
            access_by_lua_block { require("edgeweir.origin").access() }

            proxy_pass $edgeweir_upstream_scheme://edgeweir_balancer$edgeweir_upstream_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $edgeweir_upstream_host;
            proxy_set_header Connection $edgeweir_origin_connection;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Authorization $edgeweir_authorization;
            proxy_set_header X-Amz-Date $edgeweir_amz_date;
            proxy_set_header X-Amz-Content-Sha256 $edgeweir_amz_content_sha256;
            proxy_set_header X-Edgeweir-Site "";
            proxy_set_header X-Edgeweir-Rules "";
            proxy_set_header X-Edgeweir-Cache-Status "";
            proxy_set_header X-Edgeweir-Origin "";
{{- if $.ModSecurityConf }}
            proxy_set_header {{ $.WAFHeader }} "";
{{- end }}
            proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
            # SNI and certificate name of the origin chosen for the attempt
            # (set in balancer_by_lua; the default, $proxy_host, would be
            # "edgeweir_balancer").
            proxy_ssl_name $edgeweir_ssl_name;
            proxy_ssl_server_name on;
{{- if .Verify }}
{{- if $.TrustedCA }}
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 5;
            proxy_ssl_trusted_certificate {{ $.TrustedCA }};
{{- end }}
{{- else }}
            proxy_ssl_verify off;
{{- end }}
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries 3;

            header_filter_by_lua_block { require("edgeweir.origin").header_filter() }
            # Sends the error page header_filter put in place of nginx's own
            # upstream failures and of intercepted origin errors.
            body_filter_by_lua_block { require("edgeweir.origin").body_filter() }
            log_by_lua_block { require("edgeweir.origin").log() }
        }
    }
{{- end }}

    # Edge layer: one server per listener, plus a local one on a unix socket
    # that the agent's prefetch requests use when no listener is plain HTTP
    # without the PROXY protocol.
{{- range .EdgeServers }}
{{- if .Local }}

    # Local edge listener (agent prefetches; never PROXY protocol).
{{- end }}
    server {
{{- range .Listen }}
        listen {{ . }};
{{- end }}
{{- range .QUICListen }}
        listen {{ . }};
{{- end }}
{{- if .TLS }}
        http3 {{ if .HTTP3 }}on{{ else }}off{{ end }};
{{- end }}
{{- if .HTTP2 }}
        http2 on;
{{- end }}
{{- if .TLS }}
        ssl_certificate {{ $.Prefix }}/conf/bootstrap.crt;
        ssl_certificate_key {{ $.Prefix }}/conf/bootstrap.key;
        ssl_protocols TLSv1.2 TLSv1.3;
{{- if eq .CipherProfile "compatible" }}
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
{{- else }}
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
{{- end }}
        ssl_session_tickets off;
        ssl_client_hello_by_lua_block { require("edgeweir.tls").client_hello() }
        ssl_certificate_by_lua_block { require("edgeweir.tls").certificate() }
{{- end }}
{{- if .Gzip }}
        gzip on;
        gzip_vary on;
        gzip_min_length {{ .GzipMinLength }};
{{- if .GzipTypes }}
        gzip_types {{ .GzipTypes }};
{{- end }}
{{- else if or .Brotli .Zstd }}
        # Vary: Accept-Encoding on responses Brotli or Zstandard could encode.
        gzip_vary on;
{{- end }}
{{- if .Brotli }}
        brotli on;
        brotli_comp_level {{ .BrotliLevel }};
        brotli_min_length {{ .BrotliMinLength }};
{{- if .BrotliTypes }}
        brotli_types {{ .BrotliTypes }};
{{- end }}
{{- end }}
{{- if .Zstd }}
        zstd on;
        zstd_comp_level {{ .ZstdLevel }};
        zstd_min_length {{ .ZstdMinLength }};
{{- if .ZstdTypes }}
        zstd_types {{ .ZstdTypes }};
{{- end }}
{{- end }}
{{- if .ProxyProtocol }}
        # Every connection here starts with a PROXY protocol header: its
        # client address becomes $remote_addr (X-Real-IP, X-Forwarded-For
        # towards origins, logs), not the load balancer's.
        set_real_ip_from 0.0.0.0/0;
        set_real_ip_from ::/0;
        real_ip_header proxy_protocol;
{{- end }}
        server_name {{ .ServerName }};

        location / {
            set $edgeweir_site "";
            set $edgeweir_cache_zone "{{ $.DefaultZone }}";
            set $edgeweir_cache_key "";
            set $edgeweir_cache_bypass 1;
            set $edgeweir_no_cache 1;
            set $edgeweir_rules "";
            set $edgeweir_range_mode "";
            set $edgeweir_origin_layer "edgeweir_origin_verify";
            set $edgeweir_upgrade "";
            set $edgeweir_connection "";
            set $edgeweir_cdn_loop "";
            set $edgeweir_strip_ae "";
            set $edgeweir_origin_override "";
{{- if $.ModSecurityConf }}
            set $edgeweir_ctx_ref "";
{{- end }}
            access_by_lua_block { require("edgeweir.router").access() }
{{ template "edge_proxy" $ }}
            header_filter_by_lua_block { require("edgeweir.router").header_filter() }
            log_by_lua_block { require("edgeweir.stats").log() }
        }
{{- range $.WAFBodyLimits }}

        # OWASP CRS for sites inspecting {{ if . }}up to {{ . }} bytes of the request body{{ else }}no request body{{ end }}:
        # edgeweir.router sends their requests here at the end of its access
        # phase, before the cache lookup, so cache hits are inspected too.
        location @edgeweir_waf_{{ . }} {
            modsecurity on;
{{- if . }}
            modsecurity_rules 'SecRequestBodyLimit {{ . }}';
            modsecurity_rules 'SecRequestBodyNoFilesLimit {{ . }}';
{{- else }}
            modsecurity_rules 'SecRequestBodyAccess Off';
{{- end }}
            access_by_lua_block { require("edgeweir.waf").access() }
{{ template "edge_proxy" $ }}
            header_filter_by_lua_block { require("edgeweir.router").header_filter(true) }
            # Sends the error page of CRS blocks (header_filter).
            body_filter_by_lua_block { require("edgeweir.router").body_filter() }
            log_by_lua_block { require("edgeweir.stats").log(true) }
        }
{{- end }}
    }
{{- end }}
}
{{- if .L4Servers }}

# Layer-4 (TCP / UDP) applications: one server per port and protocol. Only
# the listen sockets and how a connection reaches its origin live here;
# which application a port belongs to, its origins, timeouts, IP lists and
# limits are hot-updated through the control socket into lua_shared_dict
# edgeweir_l4 (the stream subsystem's dictionaries are its own: the http
# block cannot see them, hence the relay socket below).
stream {
    lua_package_path "{{ .LuaDir }}/?.lua;;";
    lua_shared_dict edgeweir_l4 {{ .L4DictMB }}m;
    lua_shared_dict edgeweir_l4_stats 4m;
    # The relay's idle checks time out reads on purpose.
    lua_socket_log_errors off;
    init_by_lua_block {
        require("edgeweir.l4").init({
            resolvers = { {{- range $i, $r := .Resolvers }}{{ if $i }}, {{ end }}"{{ $r }}"{{ end -}} },
            ipv6 = {{ .ResolverIPv6 }},
            conf_id = "{{ .ConfID }}",
        })
    }
    init_worker_by_lua_block { require("edgeweir.l4").init_worker() }

    # Every attempt's origin, connect timeout and idle timeout (the
    # proxy_timeout of the session) are set in Lua.
    upstream edgeweir_l4 {
        server 0.0.0.1:1;
        balancer_by_lua_block { require("edgeweir.l4").balance() }
    }

    # Control relay: reachable only through its unix socket from the
    # control API (/v1/l4).
    server {
        listen unix:{{ .L4Socket }};
        content_by_lua_block { require("edgeweir.l4control").handle() }
    }
{{- range .L4Servers }}

    # {{ if eq .Protocol "udp" }}UDP {{ .Port }}: every datagram an origin answers goes back to the
    # client (no proxy_responses); a session ends after its idle timeout.
    {{- else }}TCP {{ .Port }}{{ if .Accept }}, PROXY protocol from clients{{ end }}{{ if .Relay }}, relayed with a PROXY protocol header{{ else if .ProxyProtocol }}, PROXY protocol {{ if eq .ProxyProtocol "on" }}v1{{ else }}v2{{ end }} to origins{{ end }}.{{ end }}
    server {
{{- range .Listen }}
        listen {{ . }};
{{- end }}
        preread_by_lua_block { require("edgeweir.l4").preread() }
{{- if .Relay }}
        # nginx would send the load balancer's address: the relay passes on
        # the client's from the header it received.
        content_by_lua_block { require("edgeweir.l4").relay() }
{{- else }}
        proxy_pass edgeweir_l4;
{{- if .ProxyProtocol }}
        proxy_protocol {{ .ProxyProtocol }};
{{- end }}
{{- end }}
        log_by_lua_block { require("edgeweir.l4").log() }
    }
{{- end }}
}
{{- end }}
{{- define "edge_proxy" }}
            slice 1m;
            proxy_pass http://$edgeweir_origin_layer;
            proxy_http_version 1.1;
            proxy_set_header Connection $edgeweir_connection;
            proxy_set_header Upgrade $edgeweir_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Accept-Encoding $edgeweir_upstream_ae;
            # Incoming CDN-Loop plus this node's cdn-id (RFC 8586); the origin
            # layer forwards it to the origin unchanged.
            proxy_set_header CDN-Loop $edgeweir_cdn_loop;
            proxy_set_header X-Edgeweir-Site $edgeweir_site;
            proxy_set_header X-Edgeweir-Rules $edgeweir_rules;
            proxy_set_header X-Edgeweir-Cache-Status $upstream_cache_status;
            # Origin rules' group, Host, SNI and port and config rules'
            # timeouts (edgeweir.policy.origin_header).
            proxy_set_header X-Edgeweir-Origin $edgeweir_origin_override;
            proxy_set_header Range $edgeweir_range;
            proxy_set_header If-Range $edgeweir_if_range;
            # One request id for the client, the origin layer and the origin.
            proxy_set_header X-Request-Id $edgeweir_request_id;
            # Timeouts towards origins are per site in the origin layer; these
            # only bound the local hop (long for WebSocket).
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;

            proxy_cache $edgeweir_cache_zone;
            proxy_cache_key $edgeweir_cache_key$edgeweir_slice_key;
            proxy_cache_bypass $edgeweir_cache_bypass;
            proxy_no_cache $edgeweir_no_cache;
            proxy_cache_methods GET HEAD;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 10s;
            # Stale serving follows the stale-while-revalidate and
            # stale-if-error extensions the origin layer sets per rule.
            proxy_cache_background_update on;
            proxy_cache_revalidate on;
            proxy_ignore_headers X-Accel-Redirect X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
            # Never sent to clients (cache hits included): the origin's own
            # request id, Cache-Tag (edgeweir.router puts it back for sites
            # that keep it) and the origin layer's affinity announcement.
            proxy_hide_header X-Request-Id;
            proxy_hide_header Cache-Tag;
            proxy_hide_header X-Edgeweir-Affinity;

            add_header X-Cache $upstream_cache_status always;
            add_header X-Request-Id $edgeweir_request_id always;
{{- end }}
