    init_worker_by_lua_block { require("edgeweir.init").init_worker() }

    # Nameservers from /etc/resolv.conf (origins are resolved in Lua).
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    proxy_cache_path /var/cache/edgeweir-node/default levels=1:2 keys_zone=default:16m max_size=1024m inactive=3600s use_temp_path=off;

