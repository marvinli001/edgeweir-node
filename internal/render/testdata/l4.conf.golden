# Generated by edgeweir-node. DO NOT EDIT: the agent rewrites this file.
#
# Only structural settings live here (listeners, cache zones, resolver,
# trust store). Sites, domains, origins, cache rules and purge markers are
# hot-updated through the control socket into lua_shared_dict and never
# cause a reload.

worker_processes auto;
pid /var/lib/edgeweir-node/nginx/logs/nginx.pid;
error_log stderr notice;
pcre_jit on;
# Workers a reload replaces close the connections they still serve after
# this long (--stream-shutdown-timeout).
worker_shutdown_timeout 90000ms;

events {
    worker_connections 4184;
}

http {
    default_type application/octet-stream;
    server_tokens off;
    access_log off;
    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65s;
    # The largest request body limit of the sites and their rules (0: a site
    # has none); each site checks its own by Content-Length
    # (edgeweir.router). Chunked bodies are bounded by this alone.
    client_max_body_size 100m;

    client_body_temp_path /var/lib/edgeweir-node/nginx/tmp/client_body;
    proxy_temp_path /var/lib/edgeweir-node/nginx/tmp/proxy;
    fastcgi_temp_path /var/lib/edgeweir-node/nginx/tmp/fastcgi;
    uwsgi_temp_path /var/lib/edgeweir-node/nginx/tmp/uwsgi;
    scgi_temp_path /var/lib/edgeweir-node/nginx/tmp/scgi;

    lua_package_path "/usr/share/edgeweir-node/lua/?.lua;;";
    lua_shared_dict edgeweir_sites 64m;
    lua_shared_dict edgeweir_meta 1m;
    lua_shared_dict edgeweir_stats 16m;
    lua_shared_dict edgeweir_purge 32m;
    lua_shared_dict edgeweir_health 4m;
    lua_shared_dict edgeweir_policy_logs 1m;
    lua_shared_dict edgeweir_topstats 8m;
    lua_shared_dict edgeweir_logs 8m;
    lua_shared_dict edgeweir_bans 32m;
    lua_shared_dict edgeweir_challenge 8m;
    lua_shared_dict edgeweir_cc 32m;
    lua_shared_dict edgeweir_tags 64m;
    lua_shared_dict edgeweir_purge_rate 1m;
    # Error-level log lines, per worker, to tell TLS failures of origin
    # attempts apart from connection failures (edgeweir.upstreamerr).
    lua_capture_error_log 64k;
    init_by_lua_block {
        require("edgeweir.init").init({
            resolvers = {"127.0.0.11"},
            ipv6 = true,
            -- Identifies this file; GET /v1/status reports it, so the agent
            -- can tell that a reload really loaded it.
            conf_id = "2253413bd6b3a3b8",
            geoip_socket = "/run/edgeweir-node/control.sock.geo",
            -- The agent's socket for PURGE requests (edgeweir.purgemethod).
            agent_socket = "/run/edgeweir-node/agent.sock",
            -- Bans held in edgeweir_bans (edgeweir.bans).
            ban_capacity = 100000,
            -- The stream subsystem's control relay (edgeweir.l4control):
            -- the control API forwards /v1/l4 requests to it.
            l4_socket = "unix:/run/edgeweir-node/l4.sock",
        })
    }
    init_worker_by_lua_block { require("edgeweir.init").init_worker() }

    # Nameservers from /etc/resolv.conf (origins are resolved in Lua).
    resolver 127.0.0.11 valid=30s;
    resolver_timeout 5s;

    proxy_cache_path /var/cache/edgeweir-node/edgeweir_default levels=1:2 keys_zone=edgeweir_default:16m max_size=1024m inactive=3600s use_temp_path=off;

    # Range handling at the edge, chosen by edgeweir.router per request:
    # "slice" fetches and caches 1 MiB slices, "pass" forwards the client's
    # Range (uncached requests), anything else lets the cache fetch whole
    # objects. volatile: slice subrequests must re-evaluate $slice_range.
    map $edgeweir_range_mode $edgeweir_range {
        volatile;
        default "";
        slice   $slice_range;
        pass    $http_range;
    }
    map $edgeweir_range_mode $edgeweir_if_range {
        volatile;
        default "";
        pass    $http_if_range;
    }
    map $edgeweir_range_mode $edgeweir_slice_key {
        volatile;
        default "";
        slice   "|$slice_range";
    }
    # Accept-Encoding towards the origin: the client's, or none for sites
    # the edge compresses (edgeweir.router sets $edgeweir_strip_ae), so the
    # cache holds one uncompressed object that serves every encoding.
    map $edgeweir_strip_ae $edgeweir_upstream_ae {
        default $http_accept_encoding;
        1       "";
    }
    # X-Cache towards clients: the cache status, or nothing for sites that
    # hide it (edgeweir.router sets $edgeweir_x_cache_off). add_header runs
    # after the Lua header filter, hence a variable.
    map $edgeweir_x_cache_off $edgeweir_x_cache {
        default $upstream_cache_status;
        1       "";
    }
    map $http_upgrade $edgeweir_origin_connection {
        default upgrade;
        ""      "";
    }
    # gRPC towards an origin (the gRPC origin layers): grpcs for HTTPS
    # origins, plain HTTP/2 (h2c) otherwise.
    map $edgeweir_upstream_scheme $edgeweir_grpc_scheme {
        https   grpcs;
        default grpc;
    }
    # Request id of the edge layer (X-Request-Id, error pages, access logs):
    # the client's when it is valid, nginx's own otherwise.
    map $http_x_request_id $edgeweir_request_id {
        default $request_id;
        "~^[A-Za-z0-9._:-]{8,128}$" $http_x_request_id;
    }
    # Where error_page hands nginx's own errors (error pages): the named
    # location, or, for a request that failed in its request line
    # (malformed, URI too long) and so has no URI yet, without which nginx
    # cannot enter a named location, the internal location
    # /./edgeweir-error. No client request reaches that path: nginx resolves
    # the "." segments of every request's path.
    map $uri $edgeweir_error_page {
        ""      /./edgeweir-error;
        default @edgeweir_error;
    }

    # Edge -> origin layer (local unix sockets). The variants without TLS
    # verification serve sites that turned it off; the _h2 variants send
    # the requests to the origins over HTTP/2, the _grpc variants take the
    # edge's gRPC requests over HTTP/2 (grpc_pass) and pass them on to the
    # origins the same way. No keep-alive (nginx >= 1.29.7 would cache
    # connections by default): when a request on a reused connection fails,
    # nginx tries it again on another one (each try a new trip to the
    # origin), and the origin layer closes the connection on purpose when
    # the edge should serve a stale copy (stale-if-error, edgeweir.origin).
    # The gRPC layers keep nginx's default cache: gRPC is never cached, so
    # there is no stale copy, and its connections are HTTP/2 ones.
    upstream edgeweir_origin_verify {
        server unix:/run/edgeweir-node/origin.sock;
        keepalive 0;
    }
    upstream edgeweir_origin_noverify {
        server unix:/run/edgeweir-node/origin-noverify.sock;
        keepalive 0;
    }
    upstream edgeweir_origin_verify_h2 {
        server unix:/run/edgeweir-node/origin-h2.sock;
        keepalive 0;
    }
    upstream edgeweir_origin_noverify_h2 {
        server unix:/run/edgeweir-node/origin-noverify-h2.sock;
        keepalive 0;
    }
    upstream edgeweir_origin_verify_grpc {
        server unix:/run/edgeweir-node/origin-grpc.sock;
    }
    upstream edgeweir_origin_noverify_grpc {
        server unix:/run/edgeweir-node/origin-noverify-grpc.sock;
    }

    # Origin layer -> origins: peers, retries, timeouts and keep-alive pools
    # (keyed by address, port and SNI) are chosen per request in Lua.
    # nginx >= 1.29.7 caches upstream connections by default
    # (`keepalive 32 local`) and matches them on the peer address only: a
    # TLS connection verified for one name would be reused for a request
    # that must verify another, and sites that disable keep-alive would be
    # pooled anyway. The zero value disables that cache; pooling stays with
    # balancer.enable_keepalive, keyed by address, port and SNI. One
    # upstream per protocol (HTTP/1.1, HTTP/2, gRPC): balancer_by_lua keeps
    # the pools of each upstream apart, and a connection serves requests of
    # its own protocol only.
    upstream edgeweir_balancer {
        server 0.0.0.1;
        keepalive 0;
        balancer_by_lua_block { require("edgeweir.origin").balance() }
    }
    upstream edgeweir_balancer_h2 {
        server 0.0.0.1;
        keepalive 0;
        balancer_by_lua_block { require("edgeweir.origin").balance() }
    }
    upstream edgeweir_balancer_grpc {
        server 0.0.0.1;
        keepalive 0;
        balancer_by_lua_block { require("edgeweir.origin").balance() }
    }

    # Control API for the agent (JSON). Unix socket only, never TCP.
    server {
        listen unix:/run/edgeweir-node/control.sock;
        client_max_body_size 256m;
        client_body_buffer_size 16m;

        location / {
            content_by_lua_block { require("edgeweir.control").handle() }
        }
    }

    # Origin layer: reachable only through its
    # unix socket from the edge layer below; internal X-Edgeweir-* request
    # headers never reach the origin.
    server {
        listen unix:/run/edgeweir-node/origin.sock;
        # nginx's own errors here (uncaught Lua errors, requests nginx
        # refuses) get error pages, unless the edge may serve its stale copy
        # (edgeweir.origin.error_page); nginx's 502 and 504 stay with the
        # header filter.
        error_page 400 413 414 500 $edgeweir_error_page;
        error_page 494 =494 $edgeweir_error_page;

        location / {
            set $edgeweir_noretry "";
            set $edgeweir_upstream_scheme "http";
            set $edgeweir_upstream_host "";
            set $edgeweir_upstream_uri "";
            set $edgeweir_authorization "";
            set $edgeweir_amz_date "";
            set $edgeweir_amz_content_sha256 "";
            set $edgeweir_trust_store "missing";
            set $edgeweir_ssl_name "";
            access_by_lua_block { require("edgeweir.origin").access() }

            proxy_pass $edgeweir_upstream_scheme://edgeweir_balancer$edgeweir_upstream_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $edgeweir_upstream_host;
            proxy_set_header Connection $edgeweir_origin_connection;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Authorization $edgeweir_authorization;
            proxy_set_header X-Amz-Date $edgeweir_amz_date;
            proxy_set_header X-Amz-Content-Sha256 $edgeweir_amz_content_sha256;
            proxy_set_header X-Edgeweir-Site "";
            proxy_set_header X-Edgeweir-Rules "";
            proxy_set_header X-Edgeweir-Cache-Status "";
            proxy_set_header X-Edgeweir-Origin "";
            proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
            # SNI and certificate name of the origin chosen for the attempt
            # (set in balancer_by_lua; the default, the proxied host, would
            # be the name of the balancer upstream).
            proxy_ssl_name $edgeweir_ssl_name;
            proxy_ssl_server_name on;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            # How many origins a request tries is the length of its candidate
            # list (edgeweir.origin, OriginPool.tries); this is the maximum.
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries 5;

            header_filter_by_lua_block { require("edgeweir.origin").header_filter() }
            # Sends the error page header_filter put in place of nginx's own
            # upstream failures and of intercepted origin errors.
            body_filter_by_lua_block { require("edgeweir.origin").body_filter() }
            log_by_lua_block { require("edgeweir.origin").log() }
        }

        # Sites that retry only after connection errors and timeouts
        # (OriginPool.status_retry_disabled): edgeweir.origin.access sends
        # their requests here first thing, as nginx cannot choose the
        # conditions of the next upstream per request.
        location @edgeweir_origin_noretry {
            set $edgeweir_noretry "1";
            set $edgeweir_upstream_scheme "http";
            set $edgeweir_upstream_host "";
            set $edgeweir_upstream_uri "";
            set $edgeweir_authorization "";
            set $edgeweir_amz_date "";
            set $edgeweir_amz_content_sha256 "";
            set $edgeweir_trust_store "missing";
            set $edgeweir_ssl_name "";
            access_by_lua_block { require("edgeweir.origin").access() }

            proxy_pass $edgeweir_upstream_scheme://edgeweir_balancer$edgeweir_upstream_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $edgeweir_upstream_host;
            proxy_set_header Connection $edgeweir_origin_connection;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Authorization $edgeweir_authorization;
            proxy_set_header X-Amz-Date $edgeweir_amz_date;
            proxy_set_header X-Amz-Content-Sha256 $edgeweir_amz_content_sha256;
            proxy_set_header X-Edgeweir-Site "";
            proxy_set_header X-Edgeweir-Rules "";
            proxy_set_header X-Edgeweir-Cache-Status "";
            proxy_set_header X-Edgeweir-Origin "";
            proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
            # SNI and certificate name of the origin chosen for the attempt
            # (set in balancer_by_lua; the default, the proxied host, would
            # be the name of the balancer upstream).
            proxy_ssl_name $edgeweir_ssl_name;
            proxy_ssl_server_name on;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            # How many origins a request tries is the length of its candidate
            # list (edgeweir.origin, OriginPool.tries); this is the maximum.
            proxy_next_upstream error timeout;
            proxy_next_upstream_tries 5;

            header_filter_by_lua_block { require("edgeweir.origin").header_filter() }
            # Sends the error page header_filter put in place of nginx's own
            # upstream failures and of intercepted origin errors.
            body_filter_by_lua_block { require("edgeweir.origin").body_filter() }
            log_by_lua_block { require("edgeweir.origin").log() }
        }

        location @edgeweir_error {
            content_by_lua_block { require("edgeweir.origin").error_page() }
        }
        location = /./edgeweir-error {
            internal;
            content_by_lua_block { require("edgeweir.origin").error_page() }
        }
    }
    # Origin layer without TLS verification: reachable only through its
    # unix socket from the edge layer below; internal X-Edgeweir-* request
    # headers never reach the origin.
    server {
        listen unix:/run/edgeweir-node/origin-noverify.sock;
        # nginx's own errors here (uncaught Lua errors, requests nginx
        # refuses) get error pages, unless the edge may serve its stale copy
        # (edgeweir.origin.error_page); nginx's 502 and 504 stay with the
        # header filter.
        error_page 400 413 414 500 $edgeweir_error_page;
        error_page 494 =494 $edgeweir_error_page;

        location / {
            set $edgeweir_noretry "";
            set $edgeweir_upstream_scheme "http";
            set $edgeweir_upstream_host "";
            set $edgeweir_upstream_uri "";
            set $edgeweir_authorization "";
            set $edgeweir_amz_date "";
            set $edgeweir_amz_content_sha256 "";
            set $edgeweir_trust_store "missing";
            set $edgeweir_ssl_name "";
            access_by_lua_block { require("edgeweir.origin").access() }

            proxy_pass $edgeweir_upstream_scheme://edgeweir_balancer$edgeweir_upstream_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $edgeweir_upstream_host;
            proxy_set_header Connection $edgeweir_origin_connection;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Authorization $edgeweir_authorization;
            proxy_set_header X-Amz-Date $edgeweir_amz_date;
            proxy_set_header X-Amz-Content-Sha256 $edgeweir_amz_content_sha256;
            proxy_set_header X-Edgeweir-Site "";
            proxy_set_header X-Edgeweir-Rules "";
            proxy_set_header X-Edgeweir-Cache-Status "";
            proxy_set_header X-Edgeweir-Origin "";
            proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
            # SNI and certificate name of the origin chosen for the attempt
            # (set in balancer_by_lua; the default, the proxied host, would
            # be the name of the balancer upstream).
            proxy_ssl_name $edgeweir_ssl_name;
            proxy_ssl_server_name on;
            proxy_ssl_verify off;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            # How many origins a request tries is the length of its candidate
            # list (edgeweir.origin, OriginPool.tries); this is the maximum.
            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries 5;

            header_filter_by_lua_block { require("edgeweir.origin").header_filter() }
            # Sends the error page header_filter put in place of nginx's own
            # upstream failures and of intercepted origin errors.
            body_filter_by_lua_block { require("edgeweir.origin").body_filter() }
            log_by_lua_block { require("edgeweir.origin").log() }
        }

        # Sites that retry only after connection errors and timeouts
        # (OriginPool.status_retry_disabled): edgeweir.origin.access sends
        # their requests here first thing, as nginx cannot choose the
        # conditions of the next upstream per request.
        location @edgeweir_origin_noretry {
            set $edgeweir_noretry "1";
            set $edgeweir_upstream_scheme "http";
            set $edgeweir_upstream_host "";
            set $edgeweir_upstream_uri "";
            set $edgeweir_authorization "";
            set $edgeweir_amz_date "";
            set $edgeweir_amz_content_sha256 "";
            set $edgeweir_trust_store "missing";
            set $edgeweir_ssl_name "";
            access_by_lua_block { require("edgeweir.origin").access() }

            proxy_pass $edgeweir_upstream_scheme://edgeweir_balancer$edgeweir_upstream_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $edgeweir_upstream_host;
            proxy_set_header Connection $edgeweir_origin_connection;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Authorization $edgeweir_authorization;
            proxy_set_header X-Amz-Date $edgeweir_amz_date;
            proxy_set_header X-Amz-Content-Sha256 $edgeweir_amz_content_sha256;
            proxy_set_header X-Edgeweir-Site "";
            proxy_set_header X-Edgeweir-Rules "";
            proxy_set_header X-Edgeweir-Cache-Status "";
            proxy_set_header X-Edgeweir-Origin "";
            proxy_ignore_headers X-Accel-Redirect X-Accel-Expires X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
            # SNI and certificate name of the origin chosen for the attempt
            # (set in balancer_by_lua; the default, the proxied host, would
            # be the name of the balancer upstream).
            proxy_ssl_name $edgeweir_ssl_name;
            proxy_ssl_server_name on;
            proxy_ssl_verify off;
            proxy_connect_timeout 10s;
            proxy_send_timeout 60s;
            proxy_read_timeout 60s;
            # How many origins a request tries is the length of its candidate
            # list (edgeweir.origin, OriginPool.tries); this is the maximum.
            proxy_next_upstream error timeout;
            proxy_next_upstream_tries 5;

            header_filter_by_lua_block { require("edgeweir.origin").header_filter() }
            # Sends the error page header_filter put in place of nginx's own
            # upstream failures and of intercepted origin errors.
            body_filter_by_lua_block { require("edgeweir.origin").body_filter() }
            log_by_lua_block { require("edgeweir.origin").log() }
        }

        location @edgeweir_error {
            content_by_lua_block { require("edgeweir.origin").error_page() }
        }
        location = /./edgeweir-error {
            internal;
            content_by_lua_block { require("edgeweir.origin").error_page() }
        }
    }
    # Origin layer: reachable only through its
    # unix socket from the edge layer below; internal X-Edgeweir-* request
    # headers never reach the origin.
    # HTTP/2 to the origins.
    server {
        listen unix:/run/edgeweir-node/origin-h2.sock;
        # nginx's own errors here (uncaught Lua errors, requests nginx
        # refuses) get error pages, unless the edge may serve its stale copy
        # (edgeweir.origin.error_page); nginx's 502 and 504 stay with the
        # header filter.
        error_page 400 413 414 500 $edgeweir_error_page;
        error_page 494 =494 $edgeweir_error_page;

        location / {
            set $edgeweir_noretry "";
            set $edgeweir_upstream_scheme "http";
            set $edgeweir_upstream_host "";
            set $edgeweir_upstream_uri "";
            set $edgeweir_authorization "";
            set $edgeweir_amz_date "";
            set $edgeweir_amz_content_sha256 "";
            set $edgeweir_trust_store "missing";
            set $edgeweir_ssl_name "";
