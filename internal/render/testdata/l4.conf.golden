    # Edge layer: one server per listener, plus the local ones on unix
    # sockets (plain, and TLS when a listener is) for the agent's prefetch
    # requests.
    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        # nginx's own errors get error pages (edgeweir.router.error_page):
        # malformed requests and CRS blocks with status 400, request headers
        # (494) and URIs (414) that are too long, bodies over
        # client_max_body_size (413), plain HTTP on an HTTPS port (497),
        # uncaught Lua errors (500) and the origin layer's failures (502,
        # 504) when the cache has no stale copy to serve. 494 and 497 reach
        # the handler as they are; it answers them with 400 like nginx.
        error_page 400 413 414 500 502 504 $edgeweir_error_page;
        error_page 494 =494 $edgeweir_error_page;
        error_page 497 =497 $edgeweir_error_page;

        location / {
            set $edgeweir_local "";
            set $edgeweir_site "";
            set $edgeweir_cache_zone "edgeweir_default";
            set $edgeweir_cache_key "";
            set $edgeweir_cache_bypass 1;
            set $edgeweir_no_cache 1;
            set $edgeweir_rules "";
            set $edgeweir_range_mode "";
            set $edgeweir_origin_layer "edgeweir_origin_verify";
            set $edgeweir_upgrade "";
            set $edgeweir_connection "";
            set $edgeweir_cdn_loop "";
            set $edgeweir_strip_ae "";
            set $edgeweir_origin_override "";
            set $edgeweir_x_cache_off "";
            # The request context across the hand-over to a CRS or gRPC
            # location (edgeweir.waf.stash_ctx).
            set $edgeweir_ctx_ref "";
            access_by_lua_block { require("edgeweir.router").access() }

            slice 1m;
            proxy_pass http://$edgeweir_origin_layer;
            proxy_http_version 1.1;
            proxy_set_header Connection $edgeweir_connection;
            proxy_set_header Upgrade $edgeweir_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Accept-Encoding $edgeweir_upstream_ae;
            # Incoming CDN-Loop plus this node's cdn-id (RFC 8586); the origin
            # layer forwards it to the origin unchanged.
            proxy_set_header CDN-Loop $edgeweir_cdn_loop;
            proxy_set_header X-Edgeweir-Site $edgeweir_site;
            proxy_set_header X-Edgeweir-Rules $edgeweir_rules;
            proxy_set_header X-Edgeweir-Cache-Status $upstream_cache_status;
            # Origin rules' group, Host, SNI and port and config rules'
            # timeouts (edgeweir.policy.origin_header).
            proxy_set_header X-Edgeweir-Origin $edgeweir_origin_override;
            proxy_set_header Range $edgeweir_range;
            proxy_set_header If-Range $edgeweir_if_range;
            # One request id for the client, the origin layer and the origin.
            proxy_set_header X-Request-Id $edgeweir_request_id;
            # Timeouts towards origins are per site in the origin layer; these
            # only bound the local hop (long for WebSocket).
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;

            proxy_cache $edgeweir_cache_zone;
            proxy_cache_key $edgeweir_cache_key$edgeweir_slice_key;
            proxy_cache_bypass $edgeweir_cache_bypass;
            proxy_no_cache $edgeweir_no_cache;
            proxy_cache_methods GET HEAD;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 10s;
            # Stale serving follows the stale-while-revalidate and
            # stale-if-error extensions the origin layer sets per rule.
            proxy_cache_background_update on;
            proxy_cache_revalidate on;
            proxy_ignore_headers X-Accel-Redirect X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
            # Never sent to clients (cache hits included): the origin's own
            # request id, Cache-Tag (edgeweir.router puts it back for sites
            # that keep it) and the origin layer's affinity announcement.
            proxy_hide_header X-Request-Id;
            proxy_hide_header Cache-Tag;
            proxy_hide_header X-Edgeweir-Affinity;
            # Set-Cookie lines of responses cached with their cookies
            # (CacheRule.cache_set_cookie): never sent as they are, cache hits
            # included; edgeweir.router turns them back into Set-Cookie only
            # on the response fetched for the request.
            proxy_hide_header X-Edgeweir-Set-Cookie;

            add_header X-Cache $edgeweir_x_cache always;
            add_header X-Request-Id $edgeweir_request_id always;
            header_filter_by_lua_block { require("edgeweir.router").header_filter() }
            log_by_lua_block { require("edgeweir.stats").log() }
        }

        # gRPC requests of sites that proxy gRPC: edgeweir.router hands them
        # here at the end of its access phase, instead of the CRS location.
        # HTTP/2 to the origin layer (grpc_pass, h2c), unbuffered both ways
        # with trailers; never cached or compressed, and no body size limit
        # (client_max_body_size counts all the data a stream ever sends).
        location @edgeweir_grpc {
            client_max_body_size 0;
            access_by_lua_block { require("edgeweir.router").grpc_access() }
            grpc_pass grpc://$edgeweir_origin_layer;
            grpc_set_header Host $host;
            grpc_set_header X-Real-IP $remote_addr;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            grpc_set_header X-Forwarded-Proto $scheme;
            grpc_set_header CDN-Loop $edgeweir_cdn_loop;
            grpc_set_header X-Edgeweir-Site $edgeweir_site;
            grpc_set_header X-Edgeweir-Origin $edgeweir_origin_override;
            grpc_set_header X-Request-Id $edgeweir_request_id;
            # Timeouts towards origins are per site in the origin layer;
            # these only bound the local hop.
            grpc_send_timeout 3600s;
            grpc_read_timeout 3600s;
            grpc_hide_header X-Request-Id;
            grpc_hide_header Cache-Tag;
            grpc_hide_header X-Edgeweir-Affinity;
            add_header X-Request-Id $edgeweir_request_id always;
            header_filter_by_lua_block { require("edgeweir.router").header_filter(true) }
            log_by_lua_block { require("edgeweir.stats").log(true) }
        }

        # Error pages of nginx's own errors (error_page above), also of
        # requests that came from a CRS or gRPC location (log: counted as
        # there).
        # Variables location / sets are unset for requests that never got
        # there.
        location @edgeweir_error {
            uninitialized_variable_warn off;
            content_by_lua_block { require("edgeweir.router").error_page() }
            log_by_lua_block { require("edgeweir.stats").log(true) }
        }
        location = /./edgeweir-error {
            internal;
            uninitialized_variable_warn off;
            content_by_lua_block { require("edgeweir.router").error_page() }
        }
    }

    # Local edge listener: agent prefetches only. edgeweir.router skips
    # bans, CC, challenges, access-denying rules and the CRS there, and
    # edgeweir.stats does not count them; origins see the address the agent
    # names (127.0.0.1).
    server {
        listen unix:/run/edgeweir-node/edge.sock default_server;
        set_real_ip_from unix:;
        real_ip_header X-Edgeweir-Prefetch-Addr;
        server_name _;
        # nginx's own errors get error pages (edgeweir.router.error_page):
        # malformed requests and CRS blocks with status 400, request headers
        # (494) and URIs (414) that are too long, bodies over
        # client_max_body_size (413), plain HTTP on an HTTPS port (497),
        # uncaught Lua errors (500) and the origin layer's failures (502,
        # 504) when the cache has no stale copy to serve. 494 and 497 reach
        # the handler as they are; it answers them with 400 like nginx.
        error_page 400 413 414 500 502 504 $edgeweir_error_page;
        error_page 494 =494 $edgeweir_error_page;
        error_page 497 =497 $edgeweir_error_page;

        location / {
            set $edgeweir_local "1";
            set $edgeweir_site "";
            set $edgeweir_cache_zone "edgeweir_default";
            set $edgeweir_cache_key "";
            set $edgeweir_cache_bypass 1;
            set $edgeweir_no_cache 1;
            set $edgeweir_rules "";
            set $edgeweir_range_mode "";
            set $edgeweir_origin_layer "edgeweir_origin_verify";
            set $edgeweir_upgrade "";
            set $edgeweir_connection "";
            set $edgeweir_cdn_loop "";
            set $edgeweir_strip_ae "";
            set $edgeweir_origin_override "";
            set $edgeweir_x_cache_off "";
            # The request context across the hand-over to a CRS or gRPC
            # location (edgeweir.waf.stash_ctx).
            set $edgeweir_ctx_ref "";
            access_by_lua_block { require("edgeweir.router").access() }

            slice 1m;
            proxy_pass http://$edgeweir_origin_layer;
            proxy_http_version 1.1;
            proxy_set_header Connection $edgeweir_connection;
            proxy_set_header Upgrade $edgeweir_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Accept-Encoding $edgeweir_upstream_ae;
            # Incoming CDN-Loop plus this node's cdn-id (RFC 8586); the origin
            # layer forwards it to the origin unchanged.
            proxy_set_header CDN-Loop $edgeweir_cdn_loop;
            proxy_set_header X-Edgeweir-Site $edgeweir_site;
            proxy_set_header X-Edgeweir-Rules $edgeweir_rules;
            proxy_set_header X-Edgeweir-Cache-Status $upstream_cache_status;
            # Origin rules' group, Host, SNI and port and config rules'
            # timeouts (edgeweir.policy.origin_header).
            proxy_set_header X-Edgeweir-Origin $edgeweir_origin_override;
            proxy_set_header Range $edgeweir_range;
            proxy_set_header If-Range $edgeweir_if_range;
            # One request id for the client, the origin layer and the origin.
            proxy_set_header X-Request-Id $edgeweir_request_id;
            # Timeouts towards origins are per site in the origin layer; these
            # only bound the local hop (long for WebSocket).
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;

            proxy_cache $edgeweir_cache_zone;
            proxy_cache_key $edgeweir_cache_key$edgeweir_slice_key;
            proxy_cache_bypass $edgeweir_cache_bypass;
            proxy_no_cache $edgeweir_no_cache;
            proxy_cache_methods GET HEAD;
            proxy_cache_lock on;
            proxy_cache_lock_timeout 10s;
            # Stale serving follows the stale-while-revalidate and
            # stale-if-error extensions the origin layer sets per rule.
            proxy_cache_background_update on;
            proxy_cache_revalidate on;
            proxy_ignore_headers X-Accel-Redirect X-Accel-Limit-Rate X-Accel-Buffering X-Accel-Charset;
            # Never sent to clients (cache hits included): the origin's own
            # request id, Cache-Tag (edgeweir.router puts it back for sites
            # that keep it) and the origin layer's affinity announcement.
            proxy_hide_header X-Request-Id;
            proxy_hide_header Cache-Tag;
            proxy_hide_header X-Edgeweir-Affinity;
            # Set-Cookie lines of responses cached with their cookies
            # (CacheRule.cache_set_cookie): never sent as they are, cache hits
            # included; edgeweir.router turns them back into Set-Cookie only
            # on the response fetched for the request.
            proxy_hide_header X-Edgeweir-Set-Cookie;

            add_header X-Cache $edgeweir_x_cache always;
            add_header X-Request-Id $edgeweir_request_id always;
            header_filter_by_lua_block { require("edgeweir.router").header_filter() }
            log_by_lua_block { require("edgeweir.stats").log() }
        }

        # gRPC requests of sites that proxy gRPC: edgeweir.router hands them
        # here at the end of its access phase, instead of the CRS location.
        # HTTP/2 to the origin layer (grpc_pass, h2c), unbuffered both ways
        # with trailers; never cached or compressed, and no body size limit
        # (client_max_body_size counts all the data a stream ever sends).
        location @edgeweir_grpc {
            client_max_body_size 0;
            access_by_lua_block { require("edgeweir.router").grpc_access() }
            grpc_pass grpc://$edgeweir_origin_layer;
            grpc_set_header Host $host;
            grpc_set_header X-Real-IP $remote_addr;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            grpc_set_header X-Forwarded-Proto $scheme;
            grpc_set_header CDN-Loop $edgeweir_cdn_loop;
            grpc_set_header X-Edgeweir-Site $edgeweir_site;
            grpc_set_header X-Edgeweir-Origin $edgeweir_origin_override;
            grpc_set_header X-Request-Id $edgeweir_request_id;
            # Timeouts towards origins are per site in the origin layer;
            # these only bound the local hop.
            grpc_send_timeout 3600s;
            grpc_read_timeout 3600s;
            grpc_hide_header X-Request-Id;
            grpc_hide_header Cache-Tag;
            grpc_hide_header X-Edgeweir-Affinity;
            add_header X-Request-Id $edgeweir_request_id always;
            header_filter_by_lua_block { require("edgeweir.router").header_filter(true) }
            log_by_lua_block { require("edgeweir.stats").log(true) }
        }

        # Error pages of nginx's own errors (error_page above), also of
        # requests that came from a CRS or gRPC location (log: counted as
        # there).
        # Variables location / sets are unset for requests that never got
        # there.
        location @edgeweir_error {
            uninitialized_variable_warn off;
            content_by_lua_block { require("edgeweir.router").error_page() }
            log_by_lua_block { require("edgeweir.stats").log(true) }
        }
        location = /./edgeweir-error {
            internal;
            uninitialized_variable_warn off;
            content_by_lua_block { require("edgeweir.router").error_page() }
        }
    }
}

# Layer-4 (TCP / UDP) applications: one server per port and protocol. Only
# the listen sockets and how a connection reaches its origin live here;
# which application a port belongs to, its origins, timeouts, IP lists and
# limits are hot-updated through the control socket into lua_shared_dict
# edgeweir_l4 (the stream subsystem's dictionaries are its own: the http
# block cannot see them, hence the relay socket below).
stream {
    lua_package_path "/usr/share/edgeweir-node/lua/?.lua;;";
    # The layer-4 table; passive health, connection counts and rates;
    # minute statistics (edgeweir.l4).
    lua_shared_dict edgeweir_l4 32m;
    lua_shared_dict edgeweir_l4_state 8m;
    lua_shared_dict edgeweir_l4_stats 4m;
    # The relay's idle checks time out reads on purpose.
    lua_socket_log_errors off;
    init_by_lua_block {
        require("edgeweir.l4").init({
            resolvers = {"127.0.0.11"},
            ipv6 = true,
            conf_id = "2253413bd6b3a3b8",
        })
    }
    init_worker_by_lua_block { require("edgeweir.l4").init_worker() }

    # Every attempt's origin, connect timeout and idle timeout (the
    # proxy_timeout of the session) are set in Lua.
    upstream edgeweir_l4 {
        server 0.0.0.1:1;
        balancer_by_lua_block { require("edgeweir.l4").balance() }
    }

    # Control relay: reachable only through its unix socket from the
    # control API (/v1/l4).
    server {
        listen unix:/run/edgeweir-node/l4.sock;
        content_by_lua_block { require("edgeweir.l4control").handle() }
    }

    # TCP 9000.
    server {
        listen 9000 reuseport;
        listen [::]:9000 reuseport;
        preread_by_lua_block { require("edgeweir.l4").preread() }
        proxy_pass edgeweir_l4;
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # TCP 9001, PROXY protocol v1 to origins.
    server {
        listen 9001 reuseport;
        listen [::]:9001 reuseport;
        preread_by_lua_block { require("edgeweir.l4").preread() }
        proxy_pass edgeweir_l4;
        proxy_protocol on;
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # TCP 9002, PROXY protocol v2 to origins.
    server {
        listen 9002 reuseport;
        listen [::]:9002 reuseport;
        preread_by_lua_block { require("edgeweir.l4").preread() }
        proxy_pass edgeweir_l4;
        proxy_protocol v2;
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # TCP 9003, PROXY protocol from clients.
    server {
        listen 9003 reuseport proxy_protocol;
        listen [::]:9003 reuseport proxy_protocol;
        preread_by_lua_block { require("edgeweir.l4").preread() }
        proxy_pass edgeweir_l4;
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # TCP 9004, PROXY protocol from clients, relayed with a PROXY protocol header.
    server {
        listen 9004 reuseport proxy_protocol;
        listen [::]:9004 reuseport proxy_protocol;
        preread_by_lua_block { require("edgeweir.l4").preread() }
        # nginx would send the load balancer's address: the relay passes on
        # the client's from the header it received.
        content_by_lua_block { require("edgeweir.l4").relay() }
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # TCP 9005, PROXY protocol from clients, relayed with a PROXY protocol header.
    server {
        listen 9005 reuseport proxy_protocol;
        listen [::]:9005 reuseport proxy_protocol;
        preread_by_lua_block { require("edgeweir.l4").preread() }
        # nginx would send the load balancer's address: the relay passes on
        # the client's from the header it received.
        content_by_lua_block { require("edgeweir.l4").relay() }
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # UDP 9000: every datagram an origin answers goes back to the
    # client (no proxy_responses); a session ends after its idle timeout.
    server {
        listen 9000 udp reuseport;
        listen [::]:9000 udp reuseport;
        preread_by_lua_block { require("edgeweir.l4").preread() }
        proxy_pass edgeweir_l4;
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # TCP 9100-9109.
    server {
        listen 9100-9109;
        listen [::]:9100-9109;
        preread_by_lua_block { require("edgeweir.l4").preread() }
        proxy_pass edgeweir_l4;
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # UDP 9100-9104: every datagram an origin answers goes back to the
    # client (no proxy_responses); a session ends after its idle timeout.
    server {
        listen 9100-9104 udp reuseport;
        listen [::]:9100-9104 udp reuseport;
        preread_by_lua_block { require("edgeweir.l4").preread() }
        proxy_pass edgeweir_l4;
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # TCP 9200, TLS terminated.
    server {
        listen 9200 reuseport ssl;
        listen [::]:9200 reuseport ssl;
        # The application's certificate and minimum version come from the
        # layer-4 table (edgeweir.l4); the bootstrap pair only satisfies
        # nginx.
        ssl_certificate /var/lib/edgeweir-node/nginx/conf/bootstrap.crt;
        ssl_certificate_key /var/lib/edgeweir-node/nginx/conf/bootstrap.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_session_tickets off;
        ssl_client_hello_by_lua_block { require("edgeweir.l4").client_hello() }
        ssl_certificate_by_lua_block { require("edgeweir.l4").certificate() }
        preread_by_lua_block { require("edgeweir.l4").preread() }
        proxy_pass edgeweir_l4;
        log_by_lua_block { require("edgeweir.l4").log() }
    }

    # TCP 9201, PROXY protocol from clients, TLS terminated.
    server {
        listen 9201 reuseport ssl proxy_protocol;
        listen [::]:9201 reuseport ssl proxy_protocol;
        # The application's certificate and minimum version come from the
        # layer-4 table (edgeweir.l4); the bootstrap pair only satisfies
        # nginx.
        ssl_certificate /var/lib/edgeweir-node/nginx/conf/bootstrap.crt;
        ssl_certificate_key /var/lib/edgeweir-node/nginx/conf/bootstrap.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
        ssl_session_tickets off;
        ssl_client_hello_by_lua_block { require("edgeweir.l4").client_hello() }
        ssl_certificate_by_lua_block { require("edgeweir.l4").certificate() }
        preread_by_lua_block { require("edgeweir.l4").preread() }
        proxy_pass edgeweir_l4;
        log_by_lua_block { require("edgeweir.l4").log() }
    }
}
