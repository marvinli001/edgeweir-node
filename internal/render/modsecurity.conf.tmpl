# Generated by edgeweir-node. DO NOT EDIT: the agent rewrites this file.
#
# ModSecurity for the sites that run the OWASP CRS. nginx.conf loads this
# file once (http level); ModSecurity is on only in the edge layer's CRS
# locations, one per request body limit. The edge layer hands each request
# its site, mode, paranoia level and anomaly threshold in {{ .Header }}.

# Engine (after modsecurity.conf-recommended of ModSecurity v3).
SecRuleEngine On
SecRequestBodyAccess On
SecRequestBodyLimitAction ProcessPartial
SecRequestBodyJsonDepthLimit 512
SecArgumentsLimit 1000
SecPcreMatchLimit 1000
SecPcreMatchLimitRecursion 1000
SecResponseBodyAccess Off
SecAuditEngine Off
SecArgumentSeparator &
SecCookieFormat 0
SecXmlExternalEntity Off
{{- if .UnicodeMap }}
SecUnicodeMapFile {{ .UnicodeMap }} 20127
{{- end }}

SecRule REQUEST_HEADERS:Content-Type "^(?:application(?:/soap\+|/)|text/)xml" \
    "id:200000,phase:1,t:none,t:lowercase,pass,nolog,ctl:requestBodyProcessor=XML"
SecRule REQUEST_HEADERS:Content-Type "^application/json" \
    "id:200001,phase:1,t:none,t:lowercase,pass,nolog,ctl:requestBodyProcessor=JSON"
SecRule &ARGS "@ge 1000" \
    "id:200007,phase:2,t:none,log,deny,status:400,msg:'Failed to fully parse request body due to large argument count',severity:2"
SecRule REQBODY_ERROR "!@eq 0" \
    "id:200002,phase:2,t:none,log,deny,status:400,msg:'Failed to parse request body.',severity:2"
SecRule MULTIPART_STRICT_ERROR "!@eq 0" \
    "id:200003,phase:2,t:none,log,deny,status:400,msg:'Multipart request body failed strict validation'"
SecRule MULTIPART_UNMATCHED_BOUNDARY "@eq 1" \
    "id:200004,phase:2,t:none,log,deny,msg:'Multipart parser detected a possible unmatched boundary.'"
SecRule TX:/^MSC_/ "!@streq 0" \
    "id:200005,phase:2,t:none,log,deny,msg:'ModSecurity internal error flagged: %{MATCHED_VAR_NAME}'"

Include {{ .CRSDir }}/crs-setup.conf

# Per-request settings from the edge layer. A missing or malformed value
# keeps the CRS defaults: paranoia level 1, threshold 5, blocking.
SecRule REQUEST_HEADERS:{{ .Header }} "@rx {{ .HeaderRegex }}" \
    "id:{{ .SettingsID }},phase:1,pass,nolog,t:none,capture,\
    setvar:'tx.edgeweir_mode=%{TX.1}',\
    setvar:'tx.blocking_paranoia_level=%{TX.2}',\
    setvar:'tx.detection_paranoia_level=%{TX.2}',\
    setvar:'tx.inbound_anomaly_score_threshold=%{TX.3}'"
SecRule TX:EDGEWEIR_MODE "@streq {{ .ModeDetect }}" \
    "id:{{ .ModeID }},phase:1,pass,nolog,t:none,ctl:ruleEngine=DetectionOnly"
{{- if .Exclusions }}

# Rules the sites excluded.
{{- range .Exclusions }}
SecRule REQUEST_HEADERS:{{ $.Header }} "@beginsWith {{ .SiteID }};" \
    "id:{{ .RuleID }},phase:1,pass,nolog,t:none{{ range .RuleIDs }},ctl:ruleRemoveById={{ . }}{{ end }}"
{{- end }}
{{- end }}
{{- if .Entries }}

# Exclusions by path or target. The edge layer matches each entry's path
# against the request's normalized path and names the entries that apply in
# {{ .ExHeader }} (",<token>,<token>,"); a token is the hash of its entry's
# content, so an entry the site table changed before this file applies to
# nothing until the reload.
{{- range .Entries }}
SecRule REQUEST_HEADERS:{{ $.ExHeader }} "@contains ,{{ .Token }}," \
    "id:{{ .RuleID }},phase:1,pass,nolog,t:none{{ range .Actions }},{{ . }}{{ end }}"
{{- end }}
{{- end }}

Include {{ .CRSDir }}/rules/*.conf
